{
  "manifest_version": 3,
  "name": "Ficha del cliente — BDI",
  "version": "0.5.3",
  "description": "Muestra la ficha del CRM del monitor al costado del chat de WhatsApp Web.",
  "permissions": [
    "sidePanel"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Ficha del cliente"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "pagina.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
